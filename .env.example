# Atlas — environment variables
#
# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored and must never be committed.

# ─── Database (backend: spring.datasource.*) ─────────────────────────────────
# Must match the credentials and published port in compose.yaml.
DATABASE_URL=jdbc:postgresql://localhost:5433/atlas
DATABASE_USER=atlas
DATABASE_PASSWORD=atlas

# ─── Backend HTTP ────────────────────────────────────────────────────────────
PORT=8080

# ─── Security ────────────────────────────────────────────────────────────────
# Signing key for access tokens (HS256). No default — a missing value must fail
# startup (NFR-2.2). At least 256 bits. Generate with:
#   openssl rand -base64 48
JWT_SECRET=

# Exact origin allowed by CORS. No wildcard in production (NFR-2.4).
# Local dev: the Vite dev server. Production: the Static Web Apps URL.
FRONTEND_ORIGIN=http://localhost:5173

# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
# Absolute base URL of the API for production builds. Leave blank in local dev —
# the Vite proxy forwards same-origin /api/... to the backend, so CORS is not
# involved. In production this is set as a Static Web Apps application setting.
# NOTE: Vite only reads .env files inside frontend/, not this root file. For a
# local override, put this variable in frontend/.env.
VITE_API_BASE_URL=
